// ═════════════════════════════════════════════════════════════════════════════
// Lead Nurturing + AI Follow-up — โมเดลใหม่ 11 ตัว
// อ้างอิงสเปก: docs/lead-nurturing-plan.md หมวด 2 "ต้องสร้างใหม่"
// ─────────────────────────────────────────────────────────────────────────────
// วิธีใช้ (ไม่ต้องแก้โมเดลเดิมแม้แต่บรรทัดเดียว):
//   cat prisma/_lead_tracking_models.prisma >> prisma/schema.prisma
//   npx prisma format && npx prisma validate
//   npx prisma migrate dev --name lead_tracking      ← สร้าง SQL (หรือเขียน SQL เองแบบ idempotent)
//   npx prisma generate                              ← ต้อง generate ก่อน build/deploy
//
// กติกาที่ไฟล์นี้ยึด (ตรงกับ schema.prisma เดิม):
//   • id String @id @default(uuid()) @db.Uuid
//   • ทุก timestamp ใช้ @db.Timestamptz (เหมือนทุกตารางเดิม) + @default(now()) เมื่อไม่ใช่ nullable
//   • ใช้ createdAt / updatedAt (@updatedAt) เหมือนโมเดลเดิม
//   • ตารางใหม่ใช้ @@map("snake_case") + @map สำหรับคอลัมน์ — ตรงกับกลุ่ม RankRuleSpec /
//     ReceiptSpec / MonthlyClosure / NotificationOutbox ที่มี @@map อยู่ในสคีมาแล้ว
//     (ตรวจ prisma/migrations/0_init/migration.sql: ตาราง אלהถูกสร้างเป็น snake_case จริง
//      ส่วนโมเดลอื่นเป็น PascalCase — ทั้งสองแบบมีอยู่ใน DB จริง จึงไม่ใช่ของใหม่ที่ขัด convention)
//     ⇒ ถ้าเขียน migration SQL เอง ให้ใช้ชื่อ snake_case เช่น visitors, visitor_events
//   • ช่องทาง/สถานะที่ยังต้องยืดหยุ่นใช้ String + comment (แบบเดียวกับ EventOutbox.status,
//     Notification.channel) ; ระดับคะแนนที่นิ่งแล้วใช้ enum EngagementLevel
//   • PDPA: เก็บ ip เป็น ipHash (ไม่เก็บ ip ดิบ) และเก็บข้อมูลเฉพาะเมื่อมีความยินยอม
//
// ⚠️ relation กับ Prospect / User — ตัดออกโดยเจตนา (จากผลทดสอบจริงกับ prisma 6.19.3):
//   Prisma บังคับให้ relation ต้องประกาศ "ทั้งสองฝั่ง" ถ้าประกาศฝั่งเดียวจะ validate ไม่ผ่าน:
//     error: The relation field `prospect` on model `Visitor` is missing an opposite
//            relation field on the model `Prospect`.  (error 10 ตัว = 10 relation)
//   การทำให้ผ่านต้องไปเติมฟิลด์ list ในบล็อก `model Prospect` ซึ่งขัดเงื่อนไข "ห้ามแตะไฟล์เดิม"
//   จึงเก็บเป็นคอลัมน์ FK ธรรมดา `@db.Uuid` (แบบเดียวกับ PlacementRequest.sponsorId,
//   Membership.approvedBy ที่มีอยู่แล้วในสคีมา) + @@index ให้ query เร็ว
//   ⇒ ไม่มี FK constraint ระดับ DB และใช้ include: { prospect: true } ไม่ได้
//     เวลาจะ join ใช้ `prospectId` แล้ว query แยก — หรือทำ relation จริงตามภาคผนวกท้ายไฟล์
//   relation ระหว่างโมเดลใหม่ด้วยกันเอง (Visitor↔VisitorEvent, Video↔VideoView,
//   Visitor↔VideoView, Video↔Recommendation) ประกาศครบสองฝั่งแล้ว — include ใช้ได้ตามปกติ
// ═════════════════════════════════════════════════════════════════════════════

// ── Enum ใหม่ (ชื่อไม่ชนกับ enum เดิมในสคีมา) ──────────────────────────────────
// ระดับคะแนนตามแผนหมวด 4: 0-19 LOW · 20-39 WARM · 40-69 INTERESTED · 70+ HIGH_INTENT
enum EngagementLevel {
  LOW
  WARM
  INTERESTED
  HIGH_INTENT
}

// ── 1) Visitor — ผู้เยี่ยมชม (ไม่ใช่ lead จนกว่าจะลงทะเบียน) ──────────────────
model Visitor {
  id             String    @id @default(uuid()) @db.Uuid
  visitorId      String    @unique @map("visitor_id") // uuid ที่เว็บสร้าง/เก็บใน localStorage+cookie
  firstVisit     DateTime  @default(now()) @map("first_visit") @db.Timestamptz
  lastVisit      DateTime  @default(now()) @map("last_visit") @db.Timestamptz
  totalVisits    Int       @default(0) @map("total_visits") // จำนวน session (นับจาก return_visit)
  totalEvents    Int       @default(0) @map("total_events")
  device         String?   // mobile | tablet | desktop
  browser        String?
  os             String?
  userAgent      String?   @map("user_agent")
  ipHash         String?   @map("ip_hash") // sha256(ip + AUTH_SECRET) — ไม่เก็บ ip ดิบ
  // unknown | granted | withdrawn — withdrawn = หยุดเก็บข้อมูลเพิ่มทุกกรณี
  consentStatus  String    @default("unknown") @map("consent_status")
  consentVersion String?   @map("consent_version")
  consentAt      DateTime? @map("consent_at") @db.Timestamptz
  // FK → Prospect.id (ไม่มี relation โดยเจตนา — ดูหัวไฟล์) ; set เมื่อลงทะเบียนเป็น lead
  prospectId     String?   @map("prospect_id") @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  events         VisitorEvent[]
  videoViews     VideoView[]

  @@index([lastVisit])
  @@index([prospectId])
  @@index([consentStatus])
  @@map("visitors")
}

// ── 2) VisitorEvent — event ดิบจากเว็บ (แหล่งคำนวณคะแนน + ส่งเข้า n8n WF01) ───
model VisitorEvent {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @unique @map("event_id") // idempotency: ยิงซ้ำไม่สร้างคะแนนซ้ำ
  visitorId    String   @map("visitor_id") @db.Uuid
  visitor      Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId    String?  @map("session_id")
  prospectId   String?  @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  // page_view | return_visit | video_view | video_progress | video_complete
  // | form_open | form_submit | topic_select | callback_request | cta_click
  type         String
  pageUrl      String?  @map("page_url") @db.Text
  pagePath     String?  @map("page_path")
  pageTitle    String?  @map("page_title")
  referrer     String?  @db.Text
  utmSource    String?  @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  utmCampaign  String?  @map("utm_campaign")
  utmTerm      String?  @map("utm_term")
  utmContent   String?  @map("utm_content")
  videoCode    String?  @map("video_code") // V-XXXX (รหัสที่หน้าเว็บส่งมา)
  videoId      String?  @map("video_id") @db.Uuid // FK จริงไปตาราง Video (ถ้ารู้)
  video        Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  watchPct     Float?   @map("watch_pct") // 0-100
  watchSeconds Int?     @map("watch_seconds")
  scoreDelta   Int      @default(0) @map("score_delta") // คะแนนที่ event นี้เพิ่ม (ตามแผนหมวด 4)
  meta         Json?    // ข้อมูลเพิ่มเติมแบบอิสระ (ไม่มี PII)
  userAgent    String?  @map("user_agent")
  ipHash       String?  @map("ip_hash")
  at           DateTime @default(now()) @db.Timestamptz // เวลาที่ event เกิด (client ส่งมาได้)
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([visitorId, at])
  @@index([prospectId, at])
  @@index([type, at])
  @@index([videoId])
  @@map("visitor_events")
}

// ── 3) Video — คลังคลิป TikTok ของเจ้าของบัญชี (ห้าม scrape — นำเข้าเอง) ──────
model Video {
  id             String   @id @default(uuid()) @db.Uuid
  videoId        String   @unique @map("video_id") // V-XXXXXX (รหัสอ้างอิงภายใน)
  title          String
  url            String   // ลิงก์ TikTok/YouTube
  tiktokId       String?  @map("tiktok_id")
  thumbnailUrl   String?  @map("thumbnail_url") @db.Text
  topic          String?  // ประกันชีวิต | สุขภาพ | วางแผนภาษี | ...
  subTopic       String?  @map("sub_topic")
  targetInterest String?  @map("target_interest") // ความสนใจเป้าหมายที่คลิปนี้ตอบ
  durationSec    Int?     @map("duration_sec")
  keywords       String[] @default([]) // คำค้น/ธีมสำหรับจับคู่ความสนใจ
  description    String?  @db.Text
  transcript     String?  @db.Text // ทรานสคริปต์ที่เจ้าของบัญชีนำเข้า (ไม่ใช่การ scrape)
  cta            String?  // ข้อความชวนทำต่อท้ายคลิป
  ctaUrl         String?  @map("cta_url") @db.Text
  priority       Int      @default(0) // ยิ่งมากยิ่งเสนอก่อน
  status         String   @default("active") // active | draft | paused | archived
  viewCount      Int      @default(0) @map("view_count")
  sentCount      Int      @default(0) @map("sent_count") // ส่งให้ lead ไปแล้วกี่ครั้ง
  createdBy      String?  @map("created_by") @db.Uuid // User.id (ไม่มี relation — ดูหัวไฟล์)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  views           VideoView[]
  recommendations Recommendation[]
  events          VisitorEvent[]

  @@index([status, priority])
  @@index([topic])
  @@index([targetInterest])
  @@map("videos")
}

// ── 4) VideoView — การดูคลิปจริง (ใช้คิดคะแนน + กันเสนอคลิปซ้ำ) ───────────────
model VideoView {
  id             String    @id @default(uuid()) @db.Uuid
  visitorId      String?   @map("visitor_id") @db.Uuid
  visitor        Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  prospectId     String?   @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  videoId        String    @map("video_id") @db.Uuid
  video          Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sessionId      String?   @map("session_id")
  source         String?   // recommendation | organic | direct
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt        DateTime? @map("ended_at") @db.Timestamptz
  secondsWatched Int       @default(0) @map("seconds_watched")
  completionPct  Float     @default(0) @map("completion_pct") // 0-100
  completed      Boolean   @default(false)
  isRepeat       Boolean   @default(false) @map("is_repeat") // ดูคลิปเดิมซ้ำ (+5)
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  @@index([prospectId, videoId])
  @@index([visitorId, videoId])
  @@index([videoId])
  @@index([startedAt])
  @@map("video_views")
}

// ── 5) Recommendation — คลิปที่ AI/ตัวแทนเสนอให้ lead 1 ครั้ง ────────────────
model Recommendation {
  id          String    @id @default(uuid()) @db.Uuid
  prospectId  String    @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  videoId     String    @map("video_id") @db.Uuid
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  topic       String?
  reason      String?   @db.Text // เหตุผลที่เสนอ (ภาษาคน ไม่ใช่ "ผมรู้ว่าคุณดูอะไรอยู่")
  confidence  Float     @default(0) // 0-1 จาก AI
  matchScore  Float     @default(0) @map("match_score") // คะแนนจับคู่ความสนใจ
  status      String    @default("pending") // pending | sent | viewed | dismissed | expired
  channel     String    @default("email") // email | line | sms | web_push
  dedupeKey   String?   @unique @map("dedupe_key") // prospectId+videoId+วัน — กันเสนอซ้ำ
  createdBy   String?   @map("created_by") // ai | User.id ของตัวแทน
  sentAt      DateTime? @map("sent_at") @db.Timestamptz
  viewedAt    DateTime? @map("viewed_at") @db.Timestamptz
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@index([prospectId, status])
  @@index([videoId])
  @@index([status, createdAt])
  @@map("recommendations")
}

// ── 6) FollowUp — แผนติดตามตามวัน (day 0/1/3/7/14/30) ────────────────────────
model FollowUp {
  id          String    @id @default(uuid()) @db.Uuid
  prospectId  String    @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  dayOffset   Int       @default(0) @map("day_offset") // วันที่เท่าไรนับจากลงทะเบียน
  stepKey     String?   @map("step_key") // d0_welcome, d1_video, d3_case_study ...
  channel     String    @default("email") // email | line | sms | web_push
  topic       String?
  videoId     String?   @map("video_id") @db.Uuid // คลิปที่จะแนบ (FK ไม่มี relation)
  message     String?   @db.Text
  status      String    @default("scheduled") // scheduled | sent | skipped | cancelled | failed
  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz
  sentAt      DateTime? @map("sent_at") @db.Timestamptz
  attempts    Int       @default(0)
  skipReason  String?   @map("skip_reason") // no_consent | opted_out | frequency_cap | duplicate_video
  result      String?   // replied | no_response | opted_out | converted
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@unique([prospectId, dayOffset, channel])
  @@index([status, scheduledAt])
  @@index([prospectId, dayOffset])
  @@map("follow_ups")
}

// ── 7) EngagementScore — คะแนนความสนใจปัจจุบัน (1 แถวต่อ lead) ───────────────
model EngagementScore {
  id          String          @id @default(uuid()) @db.Uuid
  prospectId  String          @unique @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  score       Int             @default(0)
  level       EngagementLevel @default(LOW)
  breakdown   Json?           // {page_view:8, video_view:12, form_submit:20, ...} ตามแผนหมวด 4
  eventCount  Int             @default(0) @map("event_count")
  lastEventAt DateTime?       @map("last_event_at") @db.Timestamptz
  computedAt  DateTime        @default(now()) @map("computed_at") @db.Timestamptz
  createdAt   DateTime        @default(now()) @db.Timestamptz
  updatedAt   DateTime        @updatedAt @db.Timestamptz

  @@index([level, score])
  @@map("engagement_scores")
}

// ── 8) LeadInterest — ความสนใจรายหัวข้อ (น้ำหนักไว้จับคู่คลิป) ───────────────
model LeadInterest {
  id          String   @id @default(uuid()) @db.Uuid
  prospectId  String   @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  topic       String
  weight      Float    @default(0) // 0-1 (ยิ่งมากยิ่งสนใจ)
  hits        Int      @default(0) // จำนวนครั้งที่ยืนยันความสนใจนี้
  source      String   @default("initial") // initial | behavior | ai | agent
  evidence    Json?    // event/คลิปที่ทำให้ได้น้ำหนักนี้ (ตรวจย้อนหลังได้)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@unique([prospectId, topic])
  @@index([topic, weight])
  @@map("lead_interests")
}

// ── 9) ChannelPreference — ช่องทางที่ lead เลือกให้ติดต่อ + เวลาสงบ ──────────
model ChannelPreference {
  id           String   @id @default(uuid()) @db.Uuid
  prospectId   String   @unique @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  email        Boolean  @default(false)
  emailAddress String?  @map("email_address")
  line         Boolean  @default(false)
  lineUserId   String?  @map("line_user_id")
  sms          Boolean  @default(false)
  phone        String?
  webPush      Boolean  @default(false) @map("web_push")
  preferred    String?  // email | line | sms | web_push (ช่องทางที่ควรใช้ก่อน)
  timezone     String   @default("Asia/Bangkok")
  quietHours   String?  @map("quiet_hours") // "21:00-08:00" — ห้ามส่งในช่วงนี้
  chosenAt     DateTime @default(now()) @map("chosen_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@map("channel_preferences")
}

// ── 10) Unsubscribe — หยุดติดตาม (มี record = หยุดทุกอย่างทันทีตาม scope) ────
model Unsubscribe {
  id             String   @id @default(uuid()) @db.Uuid
  prospectId     String?  @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  visitorId      String?  @map("visitor_id") // กรณีถอนก่อนเป็น lead
  contact        String?  // อีเมล หรือ เบอร์โทร (ค่าที่ใช้เทียบตอนจะส่ง)
  channel        String   @default("all") // all | email | line | sms | web_push
  scope          String   @default("all") // all | marketing | followup | recommendation
  reason         String?  // เหตุผลที่ผู้ใช้ให้ไว้ (ถ้ากรอก)
  source         String   @default("link") // link | api | reply | admin | phone
  token          String?  @unique // โทเคนลงนามในลิงก์ยกเลิก (กันการถอนแทนคนอื่น)
  ipHash         String?  @map("ip_hash")
  // สเปก (แผนหมวด 2) ใช้ชื่อ 'at' — ชื่อคอลัมน์จริงคือ at
  unsubscribedAt DateTime @default(now()) @map("at") @db.Timestamptz

  @@index([prospectId])
  @@index([contact])
  @@index([scope, channel])
  @@index([unsubscribedAt])
  @@map("unsubscribes")
}

// ── 11) AgentTask — งานที่ต้องให้ "คน" ทำ (ห้าม AI ปิดการขายเอง) ─────────────
model AgentTask {
  id            String    @id @default(uuid()) @db.Uuid
  prospectId    String?   @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  assigneeId    String?   @map("assignee_id") @db.Uuid // User.id ของตัวแทนที่รับงาน
  createdById   String?   @map("created_by_id") @db.Uuid
  // high_intent_lead | follow_up_call | recommendation_review | consent_request | data_cleanup
  type          String
  title         String
  note          String?   @db.Text
  priority      String    @default("normal") // low | normal | high | urgent
  status        String    @default("open") // open | in_progress | done | cancelled
  channel       String?   // ช่องทางที่ควรใช้ติดต่อ
  triggerScore  Int?      @map("trigger_score") // คะแนนตอนสร้างงาน (เช่น 70+)
  sourceEventId String?   @map("source_event_id") // VisitorEvent.eventId หรือ EventOutbox.eventId
  payload       Json?
  dueAt         DateTime? @map("due_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@index([priority, status])
  @@index([prospectId])
  @@map("agent_tasks")
}

// ═════════════════════════════════════════════════════════════════════════════
// ภาคผนวก (ไม่บังคับ) — ถ้าอนาคตต้องการ include: { prospect: true }
// ─────────────────────────────────────────────────────────────────────────────
// เติมฟิลด์ list พวกนี้ในบล็อก `model Prospect` (ทำได้เมื่อยอมแก้สคีมาเดิม):
//
//   model Prospect {
//     ...
//     visitors          Visitor[]
//     visitorEvents     VisitorEvent[]
//     videoViews        VideoView[]
//     recommendations   Recommendation[]
//     followUps         FollowUp[]
//     engagementScore   EngagementScore?
//     leadInterests     LeadInterest[]
//     channelPreference ChannelPreference?
//     unsubscribes      Unsubscribe[]
//     agentTasks        AgentTask[]
//   }
