// prisma/schema.prisma — AI Insurance Network Tree
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────
enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  RESIGNED
  INACTIVE
}

enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  RESIGNED
}

enum ProspectStatus {
  NEW
  CONTACTED
  INTERESTED
  APPOINTMENT
  FOLLOW_UP
  PREPARING_DOCUMENTS
  APPLIED
  CONVERTED
  NOT_INTERESTED
  UNREACHABLE
  CANCELLED
}

enum IncomeStatus {
  ESTIMATED
  PENDING
  APPROVED
  PAID
  REJECTED
  REVERSED
}

enum EmailStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  COMPLAINED
}

enum PlacementPolicy {
  STRICT_HISTORY
  VACANCY_REFILL
}

enum PayoutStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum MessageStatus {
  PENDING
  REPLIED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SupportStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

// ── Core Users & Auth ─────────────────────────────────
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  emailVerified      Boolean    @default(false)
  phone              String?    @unique
  phoneVerified      Boolean    @default(false)
  passwordHash       String?
  prefix             String?
  username           String?    @unique // ชื่อผู้ใช้สำหรับเข้าสู่ระบบ (ไม่ซ้ำ)
  nickname           String? // ชื่อเล่น (ไม่บังคับ)
  firstName          String
  lastName           String
  displayName        String?
  occupation         String? // อาชีพตอนสมัคร
  dob                DateTime?  @db.Date
  province           String?
  district           String?
  subdistrict        String?
  addressLine        String?
  zipCode            String?
  lineId             String?
  facebookUrl        String?
  tiktokUrl          String?
  branch             String?
  avatarUrl          String?
  sponsorId          String?    @db.Uuid
  sponsor            User?      @relation("UserSponsor", fields: [sponsorId], references: [id])
  sponsored          User[]     @relation("UserSponsor")
  // สเปคหมวด 4: แยก 3 คอลัมน์
  placementParentId  String?    @db.Uuid // ตำแหน่งแม่ในผัง 1 แตก 5
  placementParent    User?      @relation("UserPlacement", fields: [placementParentId], references: [id])
  placementChildren  User[]     @relation("UserPlacement")
  managerId          String?    @db.Uuid // โครงสร้างบังคับบัญชาจริง
  manager            User?      @relation("UserManager", fields: [managerId], references: [id])
  managedUsers       User[]     @relation("UserManager")
  memberCode         String?    @unique // M-XXXXXX auto
  referralCode       String?    @unique // R-XXXXXX auto
  status             UserStatus @default(PENDING)
  rankLevel          Int        @default(0) // 0=ผู้สนใจทั่วไป ... 4=ผู้จัดการภาค (สเปคหมวด 2)
  rankUpdatedAt      DateTime?  @db.Timestamptz
  mfaEnabled         Boolean    @default(false)
  mfaSecret          String?
  pdpaConsentVersion String?
  pdpaConsentedAt    DateTime?
  tosVersion         String?
  tosConsentedAt     DateTime?
  createdAt          DateTime   @default(now()) @db.Timestamptz
  approvedAt         DateTime?  @db.Timestamptz
  updatedAt          DateTime   @updatedAt @db.Timestamptz

  sessions             UserSession[]
  authIdentities       AuthIdentity[]
  referralCodeEntry    ReferralCode?
  sponsorshipAsChild   Sponsorship?        @relation("SponsorshipChild")
  sponsorshipsAsParent Sponsorship[]       @relation("SponsorshipParent")
  placementQueue       PlacementQueue?
  receiptFiles         ReceiptFile[]
  performanceLedger    PerformanceLedger[]
  roles                UserRole[]
  memberProfile        MemberProfile?
  prospectsOwned       Prospect[]          @relation("ProspectOwner")
  prospectActivities   ProspectActivity[]
  auditLogs            AuditLog[]
  aiMemories           AIMemory[]
  rankHistories        RankHistory[]
  notifications        Notification[]
  consentRecords       ConsentRecord[]
  incomeTransactions   IncomeTransaction[]
  performanceRecords   PerformanceRecord[]
  treeNode             TreeNode?
  placementsAsChild    TreePlacement[]     @relation("PlacementChild")
  member               Member?
  memberMessages       MemberMessage[]
  messageReplies       MessageReply[]
  supportTickets       SupportTicket[]
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  device       String?
  ip           String?
  userAgent    String?
  expiresAt    DateTime @db.Timestamptz
  lastActiveAt DateTime @default(now()) @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([userId])
}

model ConsentRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // PDPA, TOS, MARKETING
  version     String
  granted     Boolean  @default(true) // true=ยินยอม, false=ไม่ยินยอม (บันทึกไว้เพื่อตรวจสอบย้อนหลัง)
  source      String   @default("legacy") // register | legacy | admin
  consentedAt DateTime @default(now()) @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz
  ip          String?

  @@index([userId, type])
}

// ── Member ────────────────────────────────────────────
model MemberProfile {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @unique @db.Uuid
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId        String                 @unique // M-XXXXXX
  prospectId      String?                @unique @db.Uuid
  prospect        Prospect?              @relation(fields: [prospectId], references: [id])
  status          MemberStatus           @default(PENDING)
  branchName      String?
  regionName      String?
  licenseStatus   String?
  trainingStatus  String?
  idCardHash      String? // encrypted
  idCardLast4     String?
  directSponsorId String?                @db.Uuid
  createdAt       DateTime               @default(now()) @db.Timestamptz
  approvedAt      DateTime?              @db.Timestamptz
  qualifications  MemberQualification[]
  statusHistory   MemberStatusHistory[]
  documents       DocumentVerification[]
}

model MemberStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  memberId   String        @db.Uuid
  member     MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  reason     String?
  changedBy  String?       @db.Uuid
  createdAt  DateTime      @default(now()) @db.Timestamptz
}

model Membership {
  id         String    @id @default(uuid()) @db.Uuid
  memberId   String    @db.Uuid
  positionId String    @db.Uuid
  position   Position  @relation(fields: [positionId], references: [id])
  startAt    DateTime  @db.Timestamptz
  endAt      DateTime? @db.Timestamptz
  approvedBy String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([memberId])
}

// ── Tree 5-wide ───────────────────────────────────────
model TreeNode {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @unique @db.Uuid
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  level              Int             @default(0)
  directCount        Int             @default(0)
  isActive           Boolean         @default(true) // สเปคหมวด 9: คัดออกแล้วคงจุดเดิมเป็นไม่ใช้งาน
  createdAt          DateTime        @default(now()) @db.Timestamptz
  placementsAsParent TreePlacement[] @relation("PlacementParent")
}

model TreePlacement {
  id             String          @id @default(uuid()) @db.Uuid
  parentId       String          @db.Uuid
  parent         TreeNode        @relation("PlacementParent", fields: [parentId], references: [id], onDelete: Cascade)
  childId        String          @unique @db.Uuid
  child          User            @relation("PlacementChild", fields: [childId], references: [id], onDelete: Cascade)
  slot           Int // 1..5
  level          Int
  reason         String?
  idempotencyKey String?         @unique
  policy         PlacementPolicy @default(STRICT_HISTORY)
  createdAt      DateTime        @default(now()) @db.Timestamptz

  @@unique([parentId, slot])
  @@index([parentId])
}

model PlacementRun {
  id             String              @id @default(uuid()) @db.Uuid
  jobId          String              @unique // ใช้ติดตาม background job
  idempotencyKey String?             @unique
  status         String              @default("running") // running | paused | completed | failed
  startedBy      String?             @db.Uuid
  startedAt      DateTime            @default(now()) @db.Timestamptz
  finishedAt     DateTime?           @db.Timestamptz
  totalQueued    Int                 @default(0)
  totalSuccess   Int                 @default(0)
  totalSkipped   Int                 @default(0)
  totalFailed    Int                 @default(0)
  scopeTeamId    String?             @db.Uuid // ขอบเขตทีมที่ได้รับสิทธิ
  entries        PlacementRunEntry[]
}

model PlacementRunEntry {
  id        String       @id @default(uuid()) @db.Uuid
  runId     String       @db.Uuid
  run       PlacementRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  parentId  String?      @db.Uuid
  slot      Int?
  status    String // success | skipped | failed
  reason    String?
  createdAt DateTime     @default(now()) @db.Timestamptz

  @@index([runId])
}

model PlacementHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  parentId  String?  @db.Uuid
  slot      Int?
  level     Int?
  action    String // placed | moved | removed
  reason    String?
  changedBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
}

// ── Positions & Qualifications ────────────────────────
model Position {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique
  nameTh      String
  nameEn      String?
  icon        String?
  color       String?
  priority    Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.Timestamptz
  rules       PositionRule[]
  memberships Membership[]
}

model PositionRule {
  id          String   @id @default(uuid()) @db.Uuid
  positionId  String   @db.Uuid
  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  key         String // min_tenure_months, min_active_members, personal_premium ...
  value       Decimal  @db.Decimal(18, 2)
  description String?
}

model MemberQualification {
  id          String        @id @default(uuid()) @db.Uuid
  memberId    String        @db.Uuid
  member      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  positionId  String        @db.Uuid
  progress    Json? // {current, target, missing[]}
  isQualified Boolean       @default(false)
  evaluatedAt DateTime      @default(now()) @db.Timestamptz

  @@unique([memberId, positionId])
}

// ── Performance & Income ──────────────────────────────
model PerformanceRecord {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyRef  String?
  type       String // first_year_premium, renewal ...
  amount     Decimal  @db.Decimal(18, 2)
  period     String // YYYY-MM
  occurredAt DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([userId, period])
}

model IncomeRuleVersion {
  id            String              @id @default(uuid()) @db.Uuid
  version       String              @unique
  effectiveFrom DateTime            @db.Timestamptz
  effectiveTo   DateTime?           @db.Timestamptz
  rules         Json // array of {type, rate, base, scope}
  createdBy     String?             @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz
  transactions  IncomeTransaction[]
}

model IncomeTransaction {
  id             String             @id @default(uuid()) @db.Uuid
  transactionId  String             @unique // TX-XXXX
  userId         String             @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleVersionId  String?            @db.Uuid
  ruleVersion    IncomeRuleVersion? @relation(fields: [ruleVersionId], references: [id])
  policyRef      String?
  type           String
  period         String
  grossAmount    Decimal            @db.Decimal(18, 2)
  deductions     Decimal            @default(0) @db.Decimal(18, 2)
  tax            Decimal            @default(0) @db.Decimal(18, 2)
  netAmount      Decimal            @db.Decimal(18, 2)
  status         IncomeStatus       @default(ESTIMATED)
  approvedBy     String?            @db.Uuid
  approvedAt     DateTime?          @db.Timestamptz
  reversalOfId   String?            @unique @db.Uuid
  reversalOf     IncomeTransaction? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversal       IncomeTransaction? @relation("Reversal")
  payoutBatchId  String?            @db.Uuid
  payoutBatch    PayoutBatch?       @relation(fields: [payoutBatchId], references: [id])
  idempotencyKey String?            @unique
  occurredAt     DateTime           @db.Timestamptz
  createdAt      DateTime           @default(now()) @db.Timestamptz

  @@index([userId, period, status])
}

model PayoutBatch {
  id           String              @id @default(uuid()) @db.Uuid
  batchNo      String              @unique
  period       String
  status       PayoutStatus        @default(DRAFT)
  totalAmount  Decimal             @db.Decimal(18, 2)
  createdBy    String?             @db.Uuid
  approvedBy   String?             @db.Uuid
  paidAt       DateTime?           @db.Timestamptz
  createdAt    DateTime            @default(now()) @db.Timestamptz
  payouts      Payout[]
  transactions IncomeTransaction[]
}

model Payout {
  id        String       @id @default(uuid()) @db.Uuid
  batchId   String       @db.Uuid
  batch     PayoutBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  amount    Decimal      @db.Decimal(18, 2)
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?    @db.Timestamptz
  createdAt DateTime     @default(now()) @db.Timestamptz
}

model FinancialDocument {
  id            String                 @id @default(uuid()) @db.Uuid
  docNo         String                 @unique
  userId        String                 @db.Uuid
  type          String // income_statement, payout_cert, receipt
  period        String?
  grossAmount   Decimal                @db.Decimal(18, 2)
  tax           Decimal                @db.Decimal(18, 2)
  netAmount     Decimal                @db.Decimal(18, 2)
  status        String // issued, void
  qrHash        String?
  issuedBy      String?                @db.Uuid
  issuedAt      DateTime               @default(now()) @db.Timestamptz
  expiresAt     DateTime?              @db.Timestamptz
  pdfUrl        String?
  verifications DocumentVerification[]
}

model DocumentVerification {
  id         String            @id @default(uuid()) @db.Uuid
  documentId String            @db.Uuid
  document   FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  memberId   String?           @db.Uuid
  member     MemberProfile?    @relation(fields: [memberId], references: [id])
  verifiedAt DateTime          @default(now()) @db.Timestamptz
}

// ── Partners ─────────────────────────────────────────
model Partner {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  status         String // pending, verified, rejected
  description    String?
  logoUrl        String?
  brandGuideline String?
  approvedBy     String?   @db.Uuid
  startAt        DateTime? @db.Timestamptz
  endAt          DateTime? @db.Timestamptz
  disclaimer     String?
  createdAt      DateTime  @default(now()) @db.Timestamptz
}

// ── RBAC ─────────────────────────────────────────────
model Role {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  nameTh      String
  nameEn      String?
  color       String?
  icon        String?
  priority    Int               @default(0)
  isActive    Boolean           @default(true)
  validFrom   DateTime?         @db.Timestamptz
  validTo     DateTime?         @db.Timestamptz
  createdAt   DateTime          @default(now()) @db.Timestamptz
  permissions RolePermission[]
  userRoles   UserRole[]
  scopes      PermissionScope[]
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique // dashboard.view
  nameTh          String
  category        String?
  createdAt       DateTime         @default(now()) @db.Timestamptz
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model PermissionScope {
  id     String @id @default(uuid()) @db.Uuid
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scope  String // Own, Direct, Team, Branch, Assigned, All
  depth  Int? // max depth for Team

  @@unique([roleId, scope])
}

model MenuVisibility {
  id      String  @id @default(uuid()) @db.Uuid
  roleId  String  @db.Uuid
  menuKey String
  visible Boolean @default(true)

  @@unique([roleId, menuKey])
}

model FieldVisibility {
  id      String  @id @default(uuid()) @db.Uuid
  roleId  String  @db.Uuid
  field   String
  visible Boolean @default(false)

  @@unique([roleId, field])
}

// ── Prospects CRM ────────────────────────────────────
model Prospect {
  id             String                  @id @default(uuid()) @db.Uuid
  prospectId     String                  @unique // P-XXXXXX
  firstName      String
  lastName       String
  nickname       String?
  phone          String?
  email          String?
  province       String?
  occupation     String?
  ageRange       String?
  leadSourceId   String?                 @db.Uuid
  leadSource     LeadSource?             @relation(fields: [leadSourceId], references: [id])
  referralCode   String?
  sponsorId      String?                 @db.Uuid
  interest       String?
  assignedTo     String?                 @db.Uuid
  leadScore      Int                     @default(0)
  status         ProspectStatus          @default(NEW)
  consentStatus  String? // granted, withdrawn
  lastContactAt  DateTime?               @db.Timestamptz
  nextFollowUpAt DateTime?               @db.Timestamptz
  ownerId        String?                 @db.Uuid
  owner          User?                   @relation("ProspectOwner", fields: [ownerId], references: [id])
  memberProfile  MemberProfile?
  assignments    ProspectAssignment[]
  activities     ProspectActivity[]
  statusHistory  ProspectStatusHistory[]
  documents      ProspectDocument[]
  consents       ProspectConsent[]
  appointments   Appointment[]
  conversion     ProspectConversion?
  createdAt      DateTime                @default(now()) @db.Timestamptz
  updatedAt      DateTime                @updatedAt @db.Timestamptz
}

model LeadSource {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @db.Timestamptz
  prospects Prospect[]
}

model ProspectAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @db.Uuid
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  assigneeId String   @db.Uuid
  assignedBy String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
}

model ProspectActivity {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @db.Uuid
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  type       String // call, note, meeting
  content    String?
  createdAt  DateTime @default(now()) @db.Timestamptz
}

model ProspectStatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @db.Uuid
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  changedBy  String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
}

model ProspectDocument {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @db.Uuid
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  createdAt  DateTime @default(now()) @db.Timestamptz
}

model ProspectConsent {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @db.Uuid
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       String
  version    String
  granted    Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
}

model ProspectConversion {
  id          String   @id @default(uuid()) @db.Uuid
  prospectId  String   @unique @db.Uuid
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  userId      String?  @db.Uuid
  memberId    String?  @db.Uuid
  convertedAt DateTime @default(now()) @db.Timestamptz
  convertedBy String?  @db.Uuid
}

model Appointment {
  id         String    @id @default(uuid()) @db.Uuid
  prospectId String    @db.Uuid
  prospect   Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  title      String
  startAt    DateTime  @db.Timestamptz
  endAt      DateTime? @db.Timestamptz
  status     String    @default("scheduled")
  createdAt  DateTime  @default(now()) @db.Timestamptz
}

// ── Notifications & Email ────────────────────────────
model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String?
  channel     String // in_app, email, line, telegram
  isRead      Boolean  @default(false)
  referenceId String?
  createdAt   DateTime @default(now()) @db.Timestamptz
}

model NotificationPreference {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  eventKey String
  channel  String
  enabled  Boolean @default(true)

  @@unique([userId, eventKey, channel])
}

model EmailTemplate {
  id        String                 @id @default(uuid()) @db.Uuid
  key       String                 @unique
  nameTh    String
  subject   String
  bodyHtml  String                 @db.Text
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now()) @db.Timestamptz
  versions  EmailTemplateVersion[]
  messages  EmailMessage[]
}

model EmailTemplateVersion {
  id         String        @id @default(uuid()) @db.Uuid
  templateId String        @db.Uuid
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  subject    String
  bodyHtml   String        @db.Text
  createdAt  DateTime      @default(now()) @db.Timestamptz

  @@unique([templateId, version])
}

model EmailMessage {
  id                String             @id @default(uuid()) @db.Uuid
  eventId           String?            @db.Uuid
  idempotencyKey    String?            @unique
  templateId        String?            @db.Uuid
  template          EmailTemplate?     @relation(fields: [templateId], references: [id])
  templateVersion   Int?
  toEmail           String
  toUserId          String?            @db.Uuid
  subject           String
  bodyHtml          String             @db.Text
  status            EmailStatus        @default(QUEUED)
  providerMessageId String?
  attempts          Int                @default(0)
  error             String?            @db.Text
  queuedAt          DateTime           @default(now()) @db.Timestamptz
  sentAt            DateTime?          @db.Timestamptz
  recipients        EmailRecipient[]
  deliveryLogs      EmailDeliveryLog[]
}

model EmailRecipient {
  id        String       @id @default(uuid()) @db.Uuid
  messageId String       @db.Uuid
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  email     String
  name      String?
}

model EmailDeliveryLog {
  id               String       @id @default(uuid()) @db.Uuid
  messageId        String       @db.Uuid
  message          EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status           EmailStatus
  providerResponse String?      @db.Text
  createdAt        DateTime     @default(now()) @db.Timestamptz
}

model EmailFailure {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String?  @db.Uuid
  email     String
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
}

model EmailSuppression {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz
}

model ScheduledReport {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  frequency  String // daily, weekly, monthly, yearly
  lang       String              @default("th")
  sendAt     String? // HH:mm Asia/Bangkok
  isActive   Boolean             @default(true)
  lastSentAt DateTime?           @db.Timestamptz
  createdAt  DateTime            @default(now()) @db.Timestamptz
  logs       ReportDeliveryLog[]
}

model ReportDeliveryLog {
  id       String          @id @default(uuid()) @db.Uuid
  reportId String          @db.Uuid
  report   ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sentAt   DateTime        @default(now()) @db.Timestamptz
  status   String
}

// ── Member Messages (ข้อความ/คำถามจากสมาชิก → Admin ตอบ) ──
model MemberMessage {
  id               String            @id @default(uuid()) @db.Uuid
  memberId         String            @db.Uuid
  member           User              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  message          String            @db.Text
  status           MessageStatus     @default(PENDING)
  createdAt        DateTime          @default(now()) @db.Timestamptz
  updatedAt        DateTime          @updatedAt @db.Timestamptz
  replies          MessageReply[]
  notificationLogs NotificationLog[]

  @@index([memberId])
  @@index([status, createdAt])
}

model MessageReply {
  id           String        @id @default(uuid()) @db.Uuid
  messageId    String        @db.Uuid
  message      MemberMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  repliedBy    String        @db.Uuid
  replier      User          @relation(fields: [repliedBy], references: [id])
  replyMessage String        @db.Text
  createdAt    DateTime      @default(now()) @db.Timestamptz

  @@index([messageId])
}

// Log การส่งแจ้งเตือน (email / LINE) — แยก error ไม่ให้กระทบธุรกรรมหลัก
model NotificationLog {
  id        String             @id @default(uuid()) @db.Uuid
  type      String // member.question.new | member.question.replied | line.test
  channel   String // email | line
  target    String // email address หรือ LINE userId
  messageId String?            @db.Uuid
  message   MemberMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  status    NotificationStatus @default(PENDING)
  error     String?            @db.Text
  payload   Json?
  createdAt DateTime           @default(now()) @db.Timestamptz
  sentAt    DateTime?          @db.Timestamptz

  @@index([type, status])
  @@index([createdAt])
}

// ── Event Outbox (สเปคหมวด 12: ยอด + แจ้งเตือน atomic) ─
model EventOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique // idempotency key: event+recipient+channel
  eventType   String // member.registered, rank.promoted, period.closed ...
  payload     Json
  recipientId String?   @db.Uuid
  channel     String    @default("in_app") // in_app | email
  status      String    @default("pending") // pending | sent | failed
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  sentAt      DateTime? @db.Timestamptz

  @@index([status, createdAt])
}

// ── System Config (สเปคหมวด 1 — ชื่อระบบตั้งค่าได้) ─────────────
model SystemConfig {
  id        String   @id @default("default") // singleton
  appName   String   @default("AI INSURANCE NETWORK OS")
  appNameEn String?  @default("AI INSURANCE NETWORK OS")
  logoUrl   String?
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
}

// ── Auth Identities (สเปคหมวด 3 — กันบัญชีซ้ำ/Google-link ผิดคน) ─
model AuthIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // google | password | email
  providerUserId String? // sub จาก Google
  email          String?
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@unique([provider, providerUserId])
  @@unique([provider, email])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
}

// ── Referral & Sponsorship (สเปคหมวด 4) ────────────────────
model ReferralCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique // R-XXXXXX
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([code])
}

model Sponsorship {
  id           String   @id @default(uuid()) @db.Uuid
  childId      String   @unique @db.Uuid // ผู้ถูกแนะนำ
  child        User     @relation("SponsorshipChild", fields: [childId], references: [id], onDelete: Cascade)
  sponsorId    String   @db.Uuid // ผู้แนะนำจริง (sponsor_id)
  sponsor      User     @relation("SponsorshipParent", fields: [sponsorId], references: [id])
  referralCode String?
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([sponsorId])
}

model SponsorshipHistory {
  id           String   @id @default(uuid()) @db.Uuid
  childId      String   @db.Uuid
  oldSponsorId String?  @db.Uuid
  newSponsorId String?  @db.Uuid
  reason       String
  changedBy    String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([childId])
}

model PlacementQueue {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorId String?  @db.Uuid
  queueNo   Int      @unique @default(autoincrement())
  reason    String? // เหตุผลที่พักในคิว
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([queueNo])
}

// ── Receipts & Performance Ledger (สเปคหมวด 7) ────────────────
model ReceiptFile {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @db.Uuid
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName     String
  mimeType         String
  sizeBytes        Int
  storagePath      String?
  storageUrl       String?
  fileHash         String                @unique // sha256 ป้องกันไฟล์ซ้ำ
  status           String                @default("Uploaded") // Uploaded | Extracted | PendingVerification | Verified | Rejected | Duplicate | Reversed
  submissionAt     DateTime              @default(now()) @db.Timestamptz
  paymentAt        DateTime?             @db.Timestamptz
  policyApprovedAt DateTime?             @db.Timestamptz
  verifiedAt       DateTime?             @db.Timestamptz
  creditedPeriod   String? // YYYY-MM ที่จะนับผลงาน (แยกตามกฎ credited_period)
  createdAt        DateTime              @default(now()) @db.Timestamptz
  updatedAt        DateTime              @updatedAt @db.Timestamptz
  extractions      ReceiptExtraction[]
  verifications    ReceiptVerification[]

  @@index([userId, status])
  @@index([fileHash])
}

model ReceiptExtraction {
  id             String      @id @default(uuid()) @db.Uuid
  receiptId      String      @db.Uuid
  receipt        ReceiptFile @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  // ข้อมูล OCR รายช่องพร้อม confidence
  issuerName     String?
  receiptNo      String?
  transactionRef String?
  policyNo       String?
  payerName      String?
  paidAt         DateTime?   @db.Timestamptz
  amount         Decimal?    @db.Decimal(18, 2)
  type           String? // เบี้ยประกัน, ค่าบำเหน็จ, อื่นๆ
  periodLabel    String? // งวดเบี้ย
  agentCode      String?
  qrBarcode      String?
  confidence     Json? // {issuer:0.9, amount:0.95, ...}
  rawOcr         Json? // ผล OCR ดิบ
  correctedBy    String?     @db.Uuid // ผู้แก้ช่องที่อ่านไม่ชัด
  originalValues Json? // ค่าเดิมก่อนแก้
  createdAt      DateTime    @default(now()) @db.Timestamptz

  @@index([receiptId])
}

model ReceiptVerification {
  id         String      @id @default(uuid()) @db.Uuid
  receiptId  String      @db.Uuid
  receipt    ReceiptFile @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  result     String // Verified | Rejected | Duplicate
  reason     String?
  verifiedBy String?     @db.Uuid
  verifiedAt DateTime    @default(now()) @db.Timestamptz
  source     String? // api_verified | manual_report | ocr_only
  createdAt  DateTime    @default(now()) @db.Timestamptz

  @@index([receiptId])
}

model PerformanceLedger {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptId        String?  @unique @db.Uuid // สร้างได้ครั้งเดียวต่อใบเสร็จที่ผ่าน
  type             String // premium | commission | fyc | com | com_plus
  amount           Decimal  @db.Decimal(18, 2)
  period           String // YYYY-MM (credited_period)
  status           String   @default("active") // active | reversed
  reversalOfId     String?  @unique @db.Uuid
  periodSnapshotId String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz

  @@index([userId, period])
}

// ── Rank Plans (สเปคหมวด 6) ───────────────────────────────
model RankPlan {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  version     String        @unique // v1, v2 ...
  status      String        @default("Draft") // Draft | Active | Archived
  validFrom   DateTime?     @db.Timestamptz
  validTo     DateTime?     @db.Timestamptz
  sourceRef   String? // แหล่งอ้างอิง
  createdBy   String?       @db.Uuid
  isLegacyRef Boolean       @default(false) // ข้อมูลอ้างอิงเก่า 15 Jan 64
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz
  rules       RankRule[]
  histories   RankHistory[]
}

model RankRule {
  id                String   @id @default(uuid()) @db.Uuid
  planId            String   @db.Uuid
  plan              RankPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  targetRank        Int // 1..4 (เลื่อนไปขั้นนี้)
  // แยกฐานวัด — ห้ามใช้แทนกันโดยไม่มีนิยาม
  metric            String // premium | commission | fyc | com | com_plus
  personalMin       Decimal? @db.Decimal(18, 2)
  teamMin           Decimal? @db.Decimal(18, 2)
  qualifiedUnits    Int? // จำนวนหน่วยที่ผ่านคุณสมบัติ
  qualifiedCenters  Int? // จำนวนศูนย์ที่ผ่านคุณสมบัติ
  durationMinMonths Int?
  durationMaxMonths Int?
  licenseRequired   Boolean  @default(false)
  evalType          String   @default("auto") // auto | approval
  description       String?
  createdAt         DateTime @default(now()) @db.Timestamptz

  @@unique([planId, targetRank, metric])
  @@index([planId])
}

model RankHistory {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromRank    Int
  toRank      Int
  planId      String?   @db.Uuid
  plan        RankPlan? @relation(fields: [planId], references: [id])
  result      String // promoted | demoted | evaluated_incomplete | rejected
  evaluatedAt DateTime  @default(now()) @db.Timestamptz
  reason      String?
  snapshot    Json? // ผลงานที่ใช้ประเมิน
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
}

// ── Calendar & Maintenance (สเปคหมวด 8+9) ────────────────
model CalendarPeriod {
  id          String             @id @default(uuid()) @db.Uuid
  period      String             @unique // YYYY-MM
  startAt     DateTime           @db.Timestamptz // Asia/Bangkok 00:00 แปลงเป็น UTC เก็บ
  endAt       DateTime           @db.Timestamptz // ก่อนวันแรกเดือนถัดไป 00:00
  cutoffAt    DateTime?          @db.Timestamptz // cutoff พิเศษต่อประเภทงาน
  status      String             @default("Open") // Open | PendingFinalization | Closed
  snapshots   MonthlySnapshot[]
  adjustments PeriodAdjustment[]
  createdAt   DateTime           @default(now()) @db.Timestamptz
}

model PeriodRule {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String // submission | payment | policy_approved | verified | credited_period
  period    String? // YYYY-MM หรือ null = ทุกเดือน
  cutoffAt  DateTime @db.Timestamptz
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([kind, period])
}

model MonthlySnapshot {
  id                String         @id @default(uuid()) @db.Uuid
  period            String
  calendar          CalendarPeriod @relation(fields: [period], references: [period], onDelete: Cascade)
  userId            String         @db.Uuid
  rankLevel         Int
  planVersion       String?
  verifiedAmount    Decimal        @db.Decimal(18, 2)
  pendingAmount     Decimal        @db.Decimal(18, 2)
  rejectedAmount    Decimal        @db.Decimal(18, 2)
  remainingToTarget Decimal?       @db.Decimal(18, 2)
  snapshot          Json // ผัง/ตำแหน่ง/แผนเวอร์ชัน ณ เวลาปิดยอด
  createdAt         DateTime       @default(now()) @db.Timestamptz

  @@unique([period, userId])
  @@index([period])
  @@index([userId])
}

model PeriodAdjustment {
  id         String         @id @default(uuid()) @db.Uuid
  period     String
  calendar   CalendarPeriod @relation(fields: [period], references: [period], onDelete: Cascade)
  userId     String         @db.Uuid
  amount     Decimal        @db.Decimal(18, 2)
  reason     String
  createdBy  String?        @db.Uuid
  isReversal Boolean        @default(false)
  createdAt  DateTime       @default(now()) @db.Timestamptz

  @@index([period, userId])
}

model MaintenancePlan {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  kind              String // monthly | quarterly
  metric            String // commission | premium | com | com_plus
  status            String              @default("Draft") // Draft | Active | Archived
  cycle             String // monthly | quarterly | yearly
  graceMonths       Int                 @default(0) // ระยะผ่อนผันสมาชิกใหม่
  allowedFailCycles Int                 @default(1) // จำนวนรอบไม่ผ่านก่อนตัดสิน
  warnDaysBefore    Int[]               @default([7, 3, 1]) // แจ้งเตือนก่อนปิดยอด
  effectDate        DateTime?           @db.Timestamptz
  createdBy         String?             @db.Uuid
  isLegacyRef       Boolean             @default(false) // อ้างอิงไตรมาส 2569
  createdAt         DateTime            @default(now()) @db.Timestamptz
  updatedAt         DateTime            @updatedAt @db.Timestamptz
  rules             MaintenanceRule[]
  results           MaintenanceResult[]
}

model MaintenanceRule {
  id         String          @id @default(uuid()) @db.Uuid
  planId     String          @db.Uuid
  plan       MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  targetRank Int // 0..4
  minAmount  Decimal         @db.Decimal(18, 2)
  resultType String // warning | suspended | removed | demoted
  label      String? // ป้องกันสตาร์ / แก้สตาร์
  createdAt  DateTime        @default(now()) @db.Timestamptz

  @@unique([planId, targetRank])
  @@index([planId])
}

model MaintenanceResult {
  id         String          @id @default(uuid()) @db.Uuid
  planId     String          @db.Uuid
  plan       MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  period     String // YYYY-MM หรือ YYYY-Qn
  userId     String          @db.Uuid
  targetRank Int
  required   Decimal         @db.Decimal(18, 2)
  verified   Decimal         @db.Decimal(18, 2)
  remaining  Decimal         @db.Decimal(18, 2)
  status     String // passed | warning | suspended | removed | pending_review
  reason     String?
  decidedAt  DateTime        @default(now()) @db.Timestamptz

  @@unique([planId, period, userId])
  @@index([period, status])
}

model MembershipStatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  fromStatus String?
  toStatus   String
  reason     String?
  changedBy  String?  @db.Uuid
  period     String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([userId])
}

model ReviewRequest {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  status    String    @default("pending") // pending | approved | rejected
  reason    String
  decidedBy String?   @db.Uuid
  decidedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId, status])
}

// ── Spec §7: ตารางบังคับขั้นต่ำ (alias ครบ 10 ตาราง) ─────────────
// organizations — องค์กรเดียวต่อ deployment (multi-tenant ready)
model Organization {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique // ORG-001
  nameTh     String
  nameEn     String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now()) @db.Timestamptz
  members    Member[]
  placements Placement[]
}

// members — สมาชิกองค์กร (แยกจาก User เพื่อรองรับ import/legacy)
model Member {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id])
  userId         String?            @unique @db.Uuid
  user           User?              @relation(fields: [userId], references: [id])
  memberCode     String             @unique
  displayName    String
  rankLevel      Int                @default(0)
  status         MemberStatus       @default(PENDING)
  sponsorId      String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz
  placements     Placement[]        @relation("MemberPlacements")
  requests       PlacementRequest[]

  @@index([organizationId])
}

// placements — ตำแหน่งในผัง 1:5 (DB-enforced 1-5, unique parent+slot)
model Placement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  memberId       String       @unique @db.Uuid
  member         Member       @relation("MemberPlacements", fields: [memberId], references: [id])
  parentId       String?      @db.Uuid // null = root
  slot           Int? // 1..5, null only for root
  level          Int          @default(0)
  createdAt      DateTime     @default(now()) @db.Timestamptz

  @@unique([parentId, slot])
  @@index([organizationId])
  @@index([parentId])
}

// placement_requests — คิวจัดวาง + idempotency
model PlacementRequest {
  id             String   @id @default(uuid()) @db.Uuid
  memberId       String   @db.Uuid
  member         Member   @relation(fields: [memberId], references: [id])
  sponsorId      String?  @db.Uuid
  idempotencyKey String?  @unique
  status         String   @default("queued") // queued | placed | failed
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([status])
}

// rank_rules — กติกาเลื่อนตำแหน่ง (alias ของ RankRule + RankPlan)
model RankRuleSpec {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @db.Uuid
  targetRank  Int
  metric      String
  personalMin Decimal? @db.Decimal(18, 2)
  teamMin     Decimal? @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@map("rank_rules")
}

// receipts — ใบเสร็จ (alias ReceiptFile)
model ReceiptSpec {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @db.Uuid
  fileHash  String   @unique
  status    String   @default("Uploaded")
  amount    Decimal? @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("receipts")
}

// performance_ledger — บัญชีผลงาน (alias PerformanceLedger)
model PerformanceLedgerSpec {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @db.Uuid
  period    String
  amount    Decimal  @db.Decimal(18, 2)
  status    String   @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("performance_ledger")
}

// monthly_closures — ปิดยอดรายเดือน (alias CalendarPeriod+MonthlySnapshot)
model MonthlyClosure {
  id        String    @id @default(uuid()) @db.Uuid
  period    String    @unique // YYYY-MM
  status    String    @default("Open")
  snapshots Int       @default(0)
  closedAt  DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@map("monthly_closures")
}

// audit_logs (alias AuditLog) + notification_outbox (alias EventOutbox)
model NotificationOutbox {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique
  eventType String
  payload   Json
  channel   String   @default("in_app")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("notification_outbox")
}

// ── Audit Log (append-only) ──────────────────────────
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  reason    String?
  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([entity, entityId])
  @@index([userId])
}

// ── Commission Tables (ตารางค่าคอมมิชชั่นแยกเวอร์ชันตามช่วงเวลา) ──
model CommissionTable {
  id            String    @id @default(uuid()) @db.Uuid
  version       String    @unique
  effectiveFrom DateTime  @db.Timestamptz
  effectiveTo   DateTime? @db.Timestamptz
  sourceRef     String?
  data          Json
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz
}

// ── Receipt Settings (เมนูตั้งค่าใบเสร็จ — admin เท่านั้นที่เปลี่ยน) ──
model ReceiptSettings {
  id        String   @id @default("default")
  settings  Json
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

// ── Hermes OS — Persistent Memory (per-user, cross-session) ──
model AIMemory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // preference | fact | skill | summary
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([userId, key])
  @@index([userId])
}

// ── Support Ticket (ติดต่อ Admin แบบ Ticket System) ─────────────────────

model SupportTicket {
  id        String           @id @default(uuid()) @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String           @db.Uuid
  name      String
  phone     String?
  lineId    String?
  subject   String
  message   String           @db.Text
  status    SupportStatus    @default(NEW)
  adminNote String?          @db.Text
  createdAt DateTime         @default(now()) @db.Timestamptz
  updatedAt DateTime         @updatedAt @db.Timestamptz
  closedAt  DateTime?        @db.Timestamptz
  messages  SupportMessage[]

  @@index([userId])
  @@index([status, createdAt])
}

model SupportMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String        @db.Uuid
  senderType String // USER | ADMIN
  senderId   String        @db.Uuid
  message    String        @db.Text
  createdAt  DateTime      @default(now()) @db.Timestamptz

  @@index([ticketId])
}

// ═════════════════════════════════════════════════════════════════════════════
// Lead Nurturing + AI Follow-up — โมเดลใหม่ 11 ตัว
// อ้างอิงสเปก: docs/lead-nurturing-plan.md หมวด 2 "ต้องสร้างใหม่"
// ─────────────────────────────────────────────────────────────────────────────
// วิธีใช้ (ไม่ต้องแก้โมเดลเดิมแม้แต่บรรทัดเดียว):
//   cat prisma/_lead_tracking_models.prisma >> prisma/schema.prisma
//   npx prisma format && npx prisma validate
//   npx prisma migrate dev --name lead_tracking      ← สร้าง SQL (หรือเขียน SQL เองแบบ idempotent)
//   npx prisma generate                              ← ต้อง generate ก่อน build/deploy
//
// กติกาที่ไฟล์นี้ยึด (ตรงกับ schema.prisma เดิม):
//   • id String @id @default(uuid()) @db.Uuid
//   • ทุก timestamp ใช้ @db.Timestamptz (เหมือนทุกตารางเดิม) + @default(now()) เมื่อไม่ใช่ nullable
//   • ใช้ createdAt / updatedAt (@updatedAt) เหมือนโมเดลเดิม
//   • ตารางใหม่ใช้ @@map("snake_case") + @map สำหรับคอลัมน์ — ตรงกับกลุ่ม RankRuleSpec /
//     ReceiptSpec / MonthlyClosure / NotificationOutbox ที่มี @@map อยู่ในสคีมาแล้ว
//     (ตรวจ prisma/migrations/0_init/migration.sql: ตาราง אלהถูกสร้างเป็น snake_case จริง
//      ส่วนโมเดลอื่นเป็น PascalCase — ทั้งสองแบบมีอยู่ใน DB จริง จึงไม่ใช่ของใหม่ที่ขัด convention)
//     ⇒ ถ้าเขียน migration SQL เอง ให้ใช้ชื่อ snake_case เช่น visitors, visitor_events
//   • ช่องทาง/สถานะที่ยังต้องยืดหยุ่นใช้ String + comment (แบบเดียวกับ EventOutbox.status,
//     Notification.channel) ; ระดับคะแนนที่นิ่งแล้วใช้ enum EngagementLevel
//   • PDPA: เก็บ ip เป็น ipHash (ไม่เก็บ ip ดิบ) และเก็บข้อมูลเฉพาะเมื่อมีความยินยอม
//
// ⚠️ relation กับ Prospect / User — ตัดออกโดยเจตนา (จากผลทดสอบจริงกับ prisma 6.19.3):
//   Prisma บังคับให้ relation ต้องประกาศ "ทั้งสองฝั่ง" ถ้าประกาศฝั่งเดียวจะ validate ไม่ผ่าน:
//     error: The relation field `prospect` on model `Visitor` is missing an opposite
//            relation field on the model `Prospect`.  (error 10 ตัว = 10 relation)
//   การทำให้ผ่านต้องไปเติมฟิลด์ list ในบล็อก `model Prospect` ซึ่งขัดเงื่อนไข "ห้ามแตะไฟล์เดิม"
//   จึงเก็บเป็นคอลัมน์ FK ธรรมดา `@db.Uuid` (แบบเดียวกับ PlacementRequest.sponsorId,
//   Membership.approvedBy ที่มีอยู่แล้วในสคีมา) + @@index ให้ query เร็ว
//   ⇒ ไม่มี FK constraint ระดับ DB และใช้ include: { prospect: true } ไม่ได้
//     เวลาจะ join ใช้ `prospectId` แล้ว query แยก — หรือทำ relation จริงตามภาคผนวกท้ายไฟล์
//   relation ระหว่างโมเดลใหม่ด้วยกันเอง (Visitor↔VisitorEvent, Video↔VideoView,
//   Visitor↔VideoView, Video↔Recommendation) ประกาศครบสองฝั่งแล้ว — include ใช้ได้ตามปกติ
// ═════════════════════════════════════════════════════════════════════════════

// ── Enum ใหม่ (ชื่อไม่ชนกับ enum เดิมในสคีมา) ──────────────────────────────────
// ระดับคะแนนตามแผนหมวด 4: 0-19 LOW · 20-39 WARM · 40-69 INTERESTED · 70+ HIGH_INTENT
enum EngagementLevel {
  LOW
  WARM
  INTERESTED
  HIGH_INTENT
}

// ── 1) Visitor — ผู้เยี่ยมชม (ไม่ใช่ lead จนกว่าจะลงทะเบียน) ──────────────────
model Visitor {
  id             String    @id @default(uuid()) @db.Uuid
  visitorId      String    @unique @map("visitor_id") // uuid ที่เว็บสร้าง/เก็บใน localStorage+cookie
  firstVisit     DateTime  @default(now()) @map("first_visit") @db.Timestamptz
  lastVisit      DateTime  @default(now()) @map("last_visit") @db.Timestamptz
  totalVisits    Int       @default(0) @map("total_visits") // จำนวน session (นับจาก return_visit)
  totalEvents    Int       @default(0) @map("total_events")
  device         String? // mobile | tablet | desktop
  browser        String?
  os             String?
  userAgent      String?   @map("user_agent")
  ipHash         String?   @map("ip_hash") // sha256(ip + AUTH_SECRET) — ไม่เก็บ ip ดิบ
  // unknown | granted | withdrawn — withdrawn = หยุดเก็บข้อมูลเพิ่มทุกกรณี
  consentStatus  String    @default("unknown") @map("consent_status")
  consentVersion String?   @map("consent_version")
  consentAt      DateTime? @map("consent_at") @db.Timestamptz
  // FK → Prospect.id (ไม่มี relation โดยเจตนา — ดูหัวไฟล์) ; set เมื่อลงทะเบียนเป็น lead
  prospectId     String?   @map("prospect_id") @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  events     VisitorEvent[]
  videoViews VideoView[]

  // ── Video Intelligence — สรุปที่ AI วิเคราะห์ไว้ต่อผู้ชมรายคน ──────────────
  // เป็น "ระดับความสนใจเชิงพฤติกรรม" (Behavioral Interest Level) ไม่ใช่การยืนยันตัวตน
  engagementScore     Int       @default(0) @map("engagement_score")
  interestLevel       String    @default("COLD") @map("interest_level")
  totalWatchSeconds   Int       @default(0) @map("total_watch_seconds")
  averageWatchPercent Float     @default(0) @map("average_watch_percent")
  totalVideoViews     Int       @default(0) @map("total_video_views")
  lastAnalyzedAt      DateTime? @map("last_analyzed_at") @db.Timestamptz

  @@index([lastVisit])
  @@index([prospectId])
  @@index([consentStatus])
  @@map("visitors")
}

// ── 2) VisitorEvent — event ดิบจากเว็บ (แหล่งคำนวณคะแนน + ส่งเข้า n8n WF01) ───
model VisitorEvent {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @unique @map("event_id") // idempotency: ยิงซ้ำไม่สร้างคะแนนซ้ำ
  visitorId    String   @map("visitor_id") @db.Uuid
  visitor      Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId    String?  @map("session_id")
  prospectId   String?  @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  // page_view | return_visit | video_view | video_progress | video_complete
  // | form_open | form_submit | topic_select | callback_request | cta_click
  type         String
  pageUrl      String?  @map("page_url") @db.Text
  pagePath     String?  @map("page_path")
  pageTitle    String?  @map("page_title")
  referrer     String?  @db.Text
  utmSource    String?  @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  utmCampaign  String?  @map("utm_campaign")
  utmTerm      String?  @map("utm_term")
  utmContent   String?  @map("utm_content")
  videoCode    String?  @map("video_code") // V-XXXX (รหัสที่หน้าเว็บส่งมา)
  videoId      String?  @map("video_id") @db.Uuid // FK จริงไปตาราง Video (ถ้ารู้)
  video        Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  watchPct     Float?   @map("watch_pct") // 0-100
  watchSeconds Int?     @map("watch_seconds")
  scoreDelta   Int      @default(0) @map("score_delta") // คะแนนที่ event นี้เพิ่ม (ตามแผนหมวด 4)
  meta         Json? // ข้อมูลเพิ่มเติมแบบอิสระ (ไม่มี PII)
  userAgent    String?  @map("user_agent")
  ipHash       String?  @map("ip_hash")
  at           DateTime @default(now()) @db.Timestamptz // เวลาที่ event เกิด (client ส่งมาได้)
  createdAt    DateTime @default(now()) @db.Timestamptz
  // ── Video Intelligence: n8n ประมวลผล event นี้แล้วหรือยัง (กันประมวลผลซ้ำเมื่อ push+pull ชนกัน)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz

  @@index([visitorId, at])
  @@index([prospectId, at])
  @@index([type, at])
  @@index([videoId])
  @@map("visitor_events")
}

// ── 3) Video — คลังคลิป TikTok ของเจ้าของบัญชี (ห้าม scrape — นำเข้าเอง) ──────
model Video {
  id             String   @id @default(uuid()) @db.Uuid
  videoId        String   @unique @map("video_id") // V-XXXXXX (รหัสอ้างอิงภายใน)
  title          String
  url            String // ลิงก์ TikTok/YouTube
  tiktokId       String?  @map("tiktok_id")
  thumbnailUrl   String?  @map("thumbnail_url") @db.Text
  topic          String? // ประกันชีวิต | สุขภาพ | วางแผนภาษี | ...
  subTopic       String?  @map("sub_topic")
  targetInterest String?  @map("target_interest") // ความสนใจเป้าหมายที่คลิปนี้ตอบ
  durationSec    Int?     @map("duration_sec")
  keywords       String[] @default([]) // คำค้น/ธีมสำหรับจับคู่ความสนใจ
  description    String?  @db.Text
  transcript     String?  @db.Text // ทรานสคริปต์ที่เจ้าของบัญชีนำเข้า (ไม่ใช่การ scrape)
  cta            String? // ข้อความชวนทำต่อท้ายคลิป
  ctaUrl         String?  @map("cta_url") @db.Text
  priority       Int      @default(0) // ยิ่งมากยิ่งเสนอก่อน
  status         String   @default("active") // active | draft | paused | archived
  viewCount      Int      @default(0) @map("view_count")
  sentCount      Int      @default(0) @map("sent_count") // ส่งให้ lead ไปแล้วกี่ครั้ง
  createdBy      String?  @map("created_by") @db.Uuid // User.id (ไม่มี relation — ดูหัวไฟล์)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  views           VideoView[]
  recommendations Recommendation[]
  events          VisitorEvent[]

  @@index([status, priority])
  @@index([topic])
  @@index([targetInterest])
  @@map("videos")
}

// ── 4) VideoView — การดูคลิปจริง (ใช้คิดคะแนน + กันเสนอคลิปซ้ำ) ───────────────
model VideoView {
  id             String    @id @default(uuid()) @db.Uuid
  visitorId      String?   @map("visitor_id") @db.Uuid
  visitor        Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  prospectId     String?   @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  videoId        String    @map("video_id") @db.Uuid
  video          Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sessionId      String?   @map("session_id")
  source         String? // recommendation | organic | direct
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt        DateTime? @map("ended_at") @db.Timestamptz
  secondsWatched Int       @default(0) @map("seconds_watched")
  completionPct  Float     @default(0) @map("completion_pct") // 0-100
  completed      Boolean   @default(false)
  isRepeat       Boolean   @default(false) @map("is_repeat") // ดูคลิปเดิมซ้ำ (+5)
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  @@index([prospectId, videoId])
  @@index([visitorId, videoId])
  @@index([videoId])
  @@index([startedAt])
  @@map("video_views")
}

// ── 4.1) VideoAiAnalysis — ผลวิเคราะห์ของ AI ต่อผู้ชม 1 ครั้ง (AI เป็นสมองกลาง) ──
// เก็บ JSON ที่ AI ตอบ (structured output) + ผลจัดระดับ เพื่อทำรายงานย้อนหลังและกันแจ้งเตือนซ้ำ
// ไม่มี FK ไป Visitor โดยเจตนา: visitor_id เป็น uuid ไม่ระบุตัวตน และต้องลบได้โดยไม่กระทบผู้ใช้
model VideoAiAnalysis {
  id               String   @id @default(uuid()) @db.Uuid
  analysisId       String   @unique @map("analysis_id") // idempotency: n8n ยิงซ้ำไม่สร้างแถวใหม่
  visitorId        String?  @map("visitor_id") // anonymous visitor uuid (ไม่ใช่ตัวตนบุคคล)
  sessionId        String?  @map("session_id")
  page             String?
  videoId          String?  @map("video_id")
  engagementScore  Int      @default(0) @map("engagement_score") // 0-100
  interestLevel    String   @default("COLD") @map("interest_level") // COLD | WARM | HOT | VERY_HOT
  watchProbability String?  @map("watch_probability") // low | medium | high
  returningVisitor Boolean  @default(false) @map("returning_visitor")
  videoCompletion  Float    @default(0) @map("video_completion") // 0-1
  aiSummary        String?  @map("ai_summary") @db.Text
  recommendedAction String? @map("recommended_action") @db.Text
  reason           Json? // string[] เหตุผลประกอบ (ต้องอ้างจาก event จริงเท่านั้น)
  raw              Json? // คำตอบดิบจากโมเดล (ตรวจสอบย้อนหลัง)
  model            String?
  sendAlert        Boolean  @default(false) @map("send_alert")
  alertSent        Boolean  @default(false) @map("alert_sent")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([visitorId, createdAt])
  @@index([interestLevel, createdAt])
  @@index([engagementScore])
  @@index([createdAt])
  @@map("video_ai_analysis")
}

// ── 5) Recommendation — คลิปที่ AI/ตัวแทนเสนอให้ lead 1 ครั้ง ────────────────
model Recommendation {
  id          String    @id @default(uuid()) @db.Uuid
  prospectId  String    @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  videoId     String    @map("video_id") @db.Uuid
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  topic       String?
  reason      String?   @db.Text // เหตุผลที่เสนอ (ภาษาคน ไม่ใช่ "ผมรู้ว่าคุณดูอะไรอยู่")
  confidence  Float     @default(0) // 0-1 จาก AI
  matchScore  Float     @default(0) @map("match_score") // คะแนนจับคู่ความสนใจ
  status      String    @default("pending") // pending | sent | viewed | dismissed | expired
  channel     String    @default("email") // email | line | sms | web_push
  dedupeKey   String?   @unique @map("dedupe_key") // prospectId+videoId+วัน — กันเสนอซ้ำ
  createdBy   String?   @map("created_by") // ai | User.id ของตัวแทน
  sentAt      DateTime? @map("sent_at") @db.Timestamptz
  viewedAt    DateTime? @map("viewed_at") @db.Timestamptz
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@index([prospectId, status])
  @@index([videoId])
  @@index([status, createdAt])
  @@map("recommendations")
}

// ── 6) FollowUp — แผนติดตามตามวัน (day 0/1/3/7/14/30) ────────────────────────
model FollowUp {
  id          String    @id @default(uuid()) @db.Uuid
  prospectId  String    @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  dayOffset   Int       @default(0) @map("day_offset") // วันที่เท่าไรนับจากลงทะเบียน
  stepKey     String?   @map("step_key") // d0_welcome, d1_video, d3_case_study ...
  channel     String    @default("email") // email | line | sms | web_push
  topic       String?
  videoId     String?   @map("video_id") @db.Uuid // คลิปที่จะแนบ (FK ไม่มี relation)
  message     String?   @db.Text
  status      String    @default("scheduled") // scheduled | sent | skipped | cancelled | failed
  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz
  sentAt      DateTime? @map("sent_at") @db.Timestamptz
  attempts    Int       @default(0)
  skipReason  String?   @map("skip_reason") // no_consent | opted_out | frequency_cap | duplicate_video
  result      String? // replied | no_response | opted_out | converted
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@unique([prospectId, dayOffset, channel])
  @@index([status, scheduledAt])
  @@index([prospectId, dayOffset])
  @@map("follow_ups")
}

// ── 7) EngagementScore — คะแนนความสนใจปัจจุบัน (1 แถวต่อ lead) ───────────────
model EngagementScore {
  id          String          @id @default(uuid()) @db.Uuid
  prospectId  String          @unique @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  score       Int             @default(0)
  level       EngagementLevel @default(LOW)
  breakdown   Json? // {page_view:8, video_view:12, form_submit:20, ...} ตามแผนหมวด 4
  eventCount  Int             @default(0) @map("event_count")
  lastEventAt DateTime?       @map("last_event_at") @db.Timestamptz
  computedAt  DateTime        @default(now()) @map("computed_at") @db.Timestamptz
  createdAt   DateTime        @default(now()) @db.Timestamptz
  updatedAt   DateTime        @updatedAt @db.Timestamptz

  @@index([level, score])
  @@map("engagement_scores")
}

// ── 8) LeadInterest — ความสนใจรายหัวข้อ (น้ำหนักไว้จับคู่คลิป) ───────────────
model LeadInterest {
  id          String   @id @default(uuid()) @db.Uuid
  prospectId  String   @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  topic       String
  weight      Float    @default(0) // 0-1 (ยิ่งมากยิ่งสนใจ)
  hits        Int      @default(0) // จำนวนครั้งที่ยืนยันความสนใจนี้
  source      String   @default("initial") // initial | behavior | ai | agent
  evidence    Json? // event/คลิปที่ทำให้ได้น้ำหนักนี้ (ตรวจย้อนหลังได้)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@unique([prospectId, topic])
  @@index([topic, weight])
  @@map("lead_interests")
}

// ── 9) ChannelPreference — ช่องทางที่ lead เลือกให้ติดต่อ + เวลาสงบ ──────────
model ChannelPreference {
  id           String   @id @default(uuid()) @db.Uuid
  prospectId   String   @unique @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  email        Boolean  @default(false)
  emailAddress String?  @map("email_address")
  line         Boolean  @default(false)
  lineUserId   String?  @map("line_user_id")
  sms          Boolean  @default(false)
  phone        String?
  webPush      Boolean  @default(false) @map("web_push")
  preferred    String? // email | line | sms | web_push (ช่องทางที่ควรใช้ก่อน)
  timezone     String   @default("Asia/Bangkok")
  quietHours   String?  @map("quiet_hours") // "21:00-08:00" — ห้ามส่งในช่วงนี้
  chosenAt     DateTime @default(now()) @map("chosen_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@map("channel_preferences")
}

// ── 10) Unsubscribe — หยุดติดตาม (มี record = หยุดทุกอย่างทันทีตาม scope) ────
model Unsubscribe {
  id             String   @id @default(uuid()) @db.Uuid
  prospectId     String?  @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  visitorId      String?  @map("visitor_id") // กรณีถอนก่อนเป็น lead
  contact        String? // อีเมล หรือ เบอร์โทร (ค่าที่ใช้เทียบตอนจะส่ง)
  channel        String   @default("all") // all | email | line | sms | web_push
  scope          String   @default("all") // all | marketing | followup | recommendation
  reason         String? // เหตุผลที่ผู้ใช้ให้ไว้ (ถ้ากรอก)
  source         String   @default("link") // link | api | reply | admin | phone
  token          String?  @unique // โทเคนลงนามในลิงก์ยกเลิก (กันการถอนแทนคนอื่น)
  ipHash         String?  @map("ip_hash")
  // สเปก (แผนหมวด 2) ใช้ชื่อ 'at' — ชื่อคอลัมน์จริงคือ at
  unsubscribedAt DateTime @default(now()) @map("at") @db.Timestamptz

  @@index([prospectId])
  @@index([contact])
  @@index([scope, channel])
  @@index([unsubscribedAt])
  @@map("unsubscribes")
}

// ── 11) AgentTask — งานที่ต้องให้ "คน" ทำ (ห้าม AI ปิดการขายเอง) ─────────────
model AgentTask {
  id            String    @id @default(uuid()) @db.Uuid
  prospectId    String?   @map("prospect_id") @db.Uuid // FK → Prospect.id (ไม่มี relation)
  assigneeId    String?   @map("assignee_id") @db.Uuid // User.id ของตัวแทนที่รับงาน
  createdById   String?   @map("created_by_id") @db.Uuid
  // high_intent_lead | follow_up_call | recommendation_review | consent_request | data_cleanup
  type          String
  title         String
  note          String?   @db.Text
  priority      String    @default("normal") // low | normal | high | urgent
  status        String    @default("open") // open | in_progress | done | cancelled
  channel       String? // ช่องทางที่ควรใช้ติดต่อ
  triggerScore  Int?      @map("trigger_score") // คะแนนตอนสร้างงาน (เช่น 70+)
  sourceEventId String?   @map("source_event_id") // VisitorEvent.eventId หรือ EventOutbox.eventId
  payload       Json?
  dueAt         DateTime? @map("due_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@index([priority, status])
  @@index([prospectId])
  @@map("agent_tasks")
}

// ═════════════════════════════════════════════════════════════════════════════
// ภาคผนวก (ไม่บังคับ) — ถ้าอนาคตต้องการ include: { prospect: true }
// ─────────────────────────────────────────────────────────────────────────────
// เติมฟิลด์ list พวกนี้ในบล็อก `model Prospect` (ทำได้เมื่อยอมแก้สคีมาเดิม):
//
//   model Prospect {
//     ...
//     visitors          Visitor[]
//     visitorEvents     VisitorEvent[]
//     videoViews        VideoView[]
//     recommendations   Recommendation[]
//     followUps         FollowUp[]
//     engagementScore   EngagementScore?
//     leadInterests     LeadInterest[]
//     channelPreference ChannelPreference?
//     unsubscribes      Unsubscribe[]
//     agentTasks        AgentTask[]
//   }
//
// แล้วเปลี่ยนคอมเมนต์ "FK → Prospect.id (ไม่มี relation)" ในโมเดลใหม่เป็นฟิลด์ relation เช่น
//   prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
// จากนั้นรัน `npx prisma format && npx prisma validate`
// ═════════════════════════════════════════════════════════════════════════════

// ═════════════════════════════════════════════════════════════════════════════
// ระบบจำลองเครือข่าย 1 แตก 5 (Network Simulator) — 2026-10-02
// ห้ามนำข้อมูลในตาราง sim_* ไปรวมกับข้อมูลธุรกรรมจริงเด็ดขาด (ทุกแถวมี simulation = true)
// ═════════════════════════════════════════════════════════════════════════════

model NetworkSim {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @default("1 แตก 5 – Future Network Simulator")
  initMembers  Int      @default(1) @map("init_members")
  branchFactor Int      @default(5) @map("branch_factor")
  layers       Int      @default(5)
  growthRate   Float    @default(1) @map("growth_rate")
  months       Int      @default(12)
  incomePlan   String?  @map("income_plan") // ชื่อแผนรายได้ที่เลือก (อ้างอิงเท่านั้น ไม่ใช่การรับประกัน)
  commission   Decimal  @default(20000) @db.Decimal(12, 2) // ค่าตามกติกาในระบบ ไม่ใช่การรับประกันรายได้
  status       String   @default("running") // running | paused | completed | reset
  simulation   Boolean  @default(true)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  members  SimMember[]
  events   SimEvent[]
  payments SimPayment[]

  @@index([status])
  @@index([createdAt])
  @@map("network_sims")
}

model SimMember {
  id              String     @id @default(uuid()) @db.Uuid
  simId           String     @map("sim_id") @db.Uuid
  sim             NetworkSim @relation(fields: [simId], references: [id], onDelete: Cascade)
  memberCode      String     @map("member_code") // M0001
  parentCode      String?    @map("parent_code")
  sponsorCode     String?    @map("sponsor_code")
  level           Int        @default(1)
  position        Int        @default(1)
  status          String     @default("active") // active | inactive | simulated
  childrenCount   Int        @default(0) @map("children_count")
  qualified       Boolean    @default(false)
  promotionStatus String     @default("none") @map("promotion_status") // none | eligible | approved | rejected
  paymentVerified Boolean    @default(false) @map("payment_verified")
  receiptId       String?    @map("receipt_id")
  joinDate        DateTime   @default(now()) @map("join_date") @db.Timestamptz
  posX            Float?     @map("pos_x")
  posY            Float?     @map("pos_y")
  posZ            Float?     @map("pos_z")
  simulation      Boolean    @default(true)

  @@unique([simId, memberCode])
  @@index([simId, level])
  @@index([simId, parentCode])
  @@map("sim_members")
}

model SimEvent {
  id           String      @id @default(uuid()) @db.Uuid
  eventId      String      @unique @map("event_id")
  simId        String?     @map("sim_id") @db.Uuid
  eventType    String      @map("event_type") // MEMBER_CREATED | LEVEL_COMPLETED | PROMOTION_ELIGIBLE | ...
  memberCode   String?     @map("member_code")
  source       String      @default("dashboard") // dashboard | n8n | api
  simulation   Boolean     @default(true)
  payload      Json?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  sim          NetworkSim? @relation(fields: [simId], references: [id], onDelete: SetNull)

  @@index([simId, createdAt])
  @@index([eventType])
  @@map("sim_events")
}

model PromotionRule {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  minMembers       Int      @default(5) @map("min_members")
  minLevels        Int      @default(1) @map("min_levels")
  requiredPayment  String   @default("verified") @map("required_payment")
  requiredReceipt  Boolean  @default(true) @map("required_receipt")
  commissionAmount Decimal  @default(20000) @map("commission_amount") @db.Decimal(12, 2)
  conditions       Json?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("promotion_rules")
}

model SimPayment {
  id           String      @id @default(uuid()) @db.Uuid
  simId        String?     @map("sim_id") @db.Uuid
  paymentRef   String      @map("payment_ref")
  memberCode   String?     @map("member_code")
  amount       Decimal     @default(0) @db.Decimal(12, 2)
  status       String      @default("pending") // pending | verified | rejected | demo
  mode         String      @default("demo") // demo | live (โหมดสาธิตออกใบเสร็จ DEMO เท่านั้น)
  provider     String?
  receiptId    String?     @map("receipt_id")
  watermark    String? // "SIMULATION / DEMO – ไม่ใช่หลักฐานการชำระเงินจริง"
  verifiedAt   DateTime?   @map("verified_at") @db.Timestamptz
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  sim          NetworkSim? @relation(fields: [simId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("sim_payments")
}

// ── ตัวตรวจจับ workflow ที่ถูกสร้างใน n8n (n8n Workflow Watch) ────────────────
// ใช้โดย: scripts/n8n-workflow-watch.mjs (เครื่องที่รัน n8n) → POST /api/n8n/watch
// แล้วหน้าเว็บ /n8n/workflow-3d แสดงรายการที่ตรวจจับได้แบบสด ๆ (ผู้ใช้สั่งไว้)
model N8nWorkflowWatch {
  id           String    @id // workflow id จาก n8n (uuid) — ไม่สร้างใหม่เอง
  name         String
  active       Boolean   @default(false)
  nodeCount    Int       @default(0) @map("node_count")
  n8nCreatedAt DateTime? @map("n8n_created_at") @db.Timestamptz
  n8nUpdatedAt DateTime? @map("n8n_updated_at") @db.Timestamptz
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz // ครั้งแรกที่ระบบตรวจจับได้ = "ใหม่"
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  source       String    @default("n8n-local")

  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@map("n8n_workflow_watch")
}
