    {
      "parameters": {
        "jsCode": "\n// §19 WF09 — เตรียมคำถามสำหรับโค้ชการเงิน AI\nconst body = ($json.body && typeof $json.body === 'object') ? $json.body : ($json || {});\nconst s = (v, m) => (v === null || v === undefined) ? '' : String(v).trim().slice(0, m);\nconst question = s(body.question || body.message || body.q, 1500);\nif (!question) return [{ json: { ok: false, error: 'ต้องส่ง { question: \"...\" }', ready: false } }];\nconst history = Array.isArray(body.history) ? body.history.slice(-6).map(h => ({\n  role: (String(h.role || 'user') === 'assistant' ? 'assistant' : 'user'), content: s(h.content || h.text, 600),\n})) : [];\nreturn [{ json: { ok: true, ready: true, question, history, userId: s(body.userId, 64) || null,\n  name: s(body.name, 80) || null, rank: s(body.rank, 40) || null,\n  context: (body.context && typeof body.context === 'object') ? body.context : null } }];\n"
      },
      "id": "a1ec6a70-91ce-4ecb-9727-87720da44bdf",
      "name": "เตรียมคำถาม",
      "type": "n8n-nodes-base.code",
