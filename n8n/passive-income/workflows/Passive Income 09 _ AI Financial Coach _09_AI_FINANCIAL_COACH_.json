        "jsCode": "\nconst src = $('เตรียมคำถาม').first().json;\nconst answer = String(($json && $json.output) || '').trim();\nreturn [{ json: { ok: true, question: src.question, answer: answer, userId: src.userId,\n  answeredAt: new Date().toISOString(), source: 'n8n-pi-09' } }];\n"
