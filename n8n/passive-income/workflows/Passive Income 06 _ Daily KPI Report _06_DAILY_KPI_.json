    {
      "parameters": {
        "jsCode": "\nconst pick = (names) => { for (const n of names) { try { const j = $(n).first().json; if (j) return j; } catch (e) {} } return {}; };\n\n// §19 WF06 — รวม KPI รายวัน + เทียบกับเมื่อวาน (เก็บประวัติใน static data ของ workflow)\nconst members = pick(['KPI: สมาชิก']);\nconst leads = pick(['KPI: ผู้สนใจ']);\nconst follow = pick(['KPI: ติดตามค้าง']);\nconst tasks = pick(['KPI: งานค้าง']);\nconst visitor = pick(['KPI: ผู้เข้าชม']);\nconst stats = leads.stats || {};\nconst kpi = {\n  date: new Date().toISOString().slice(0, 10),\n  members: Number(members.total || 0), membersActive: Number(members.active || 0), membersWithRank: Number(members.withRank || 0),\n  leadsTotal: Number(leads.total || (leads.leads || []).length || 0),\n  leadsHigh: Number(stats.high || 0), leadsInterested: Number(stats.interested || 0),\n  leadsWarm: Number(stats.warm || 0), leadsLow: Number(stats.low || 0), leadsConsent: Number(stats.consent || 0),\n  followupDue: Number(follow.followUps ? follow.followUps.length : (follow.due || 0)),\n  tasksOpen: Number(tasks.total || (tasks.tasks || []).length || 0),\n  visitors: Number(visitor.count || visitor.total || 0),\n};\nconst sd = $getWorkflowStaticData('global');\nsd.history = Array.isArray(sd.history) ? sd.history : [];\nconst prev = sd.history.length ? sd.history[sd.history.length - 1] : null;\nconst diff = {};\nif (prev) for (const k of Object.keys(kpi)) {\n  if (typeof kpi[k] === 'number' && typeof prev[k] === 'number') diff[k] = kpi[k] - prev[k];\n}\nsd.history.push(kpi);\nif (sd.history.length > 90) sd.history = sd.history.slice(-90);\nconst trend = (v) => v > 0 ? ('+' + v) : String(v);\nreturn [{ json: { kpi, diff, prevDate: prev ? prev.date : null, days: sd.history.length,\n  headline: 'ผู้สนใจใหม่รวม ' + kpi.leadsTotal + ' (HOT ' + kpi.leadsHigh + ') · งานค้าง ' + kpi.tasksOpen\n    + ' · ติดตามค้าง ' + kpi.followupDue + ' · สมาชิก active ' + kpi.membersActive + '/' + kpi.members,\n  dayOverDay: prev ? ('สมาชิก ' + trend(diff.members || 0) + ' · ผู้สนใจ ' + trend(diff.leadsTotal || 0)\n    + ' · HOT ' + trend(diff.leadsHigh || 0) + ' · งานค้าง ' + trend(diff.tasksOpen || 0)) : 'ไม่มีข้อมูลเมื่อวาน (รอบแรก)',\n  sources: { members: !!members.total, leads: !!leads.total, followup: !!follow, tasks: !!tasks.total, visitor: !!visitor.count } } }];\n"
      },
