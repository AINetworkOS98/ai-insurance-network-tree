    {
      "parameters": {
        "jsCode": "\nconst pick = (names) => { for (const n of names) { try { const j = $(n).first().json; if (j) return j; } catch (e) {} } return {}; };\n\n// §19 WF07 — รวบรวมข้อมูลสัปดาห์ + ประวัติ KPI 7 วันล่าสุด\nconst leads = pick(['รวบรวม: ผู้สนใจ']);\nconst members = pick(['รวบรวม: สมาชิก']);\nconst follow = pick(['รวบรวม: ติดตาม']);\nconst stats = leads.stats || {};\nconst sd = $getWorkflowStaticData('global');\nconst history = (Array.isArray(sd.history) ? sd.history : []).slice(-7);\nconst first = history.length ? history[0] : null;\nconst last = history.length ? history[history.length - 1] : null;\nconst delta = (k) => (first && last && typeof first[k] === 'number' && typeof last[k] === 'number') ? last[k] - first[k] : null;\nconst week = {\n  weekEnding: new Date().toISOString().slice(0, 10),\n  leadsNow: Number(leads.total || 0), leadsHigh: Number(stats.high || 0), leadsInterested: Number(stats.interested || 0),\n  membersNow: Number(members.total || 0), membersActive: Number(members.active || 0),\n  followupDueNow: Number(follow.followUps ? follow.followUps.length : (follow.due || 0)),\n  snapshots: history.length,\n  growth: { members: delta('members'), leads: delta('leadsTotal'), hot: delta('leadsHigh'), tasks: delta('tasksOpen') },\n};\nreturn [{ json: { week, history, dataReady: true } }];\n"
      },
